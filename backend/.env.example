PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/stayserve
JWT_SECRET=replace-this-with-a-long-random-secret
# Optional: separate key for the developer "view password" support feature.
# Falls back to JWT_SECRET when unset (min 32 chars either way).
# PASSWORD_VAULT_KEY=another-long-random-secret-for-password-viewing
# Required: comma-separated list of browser origins allowed by CORS.
# The API will refuse to start without at least one origin here.
CLIENT_URLS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false

# Rate limiting — requests per client IP inside one shared window (default 15 min).
# RATE_LIMIT_MAX covers every API endpoint; LOGIN_RATE_LIMIT_MAX counts only
# failed sign-in attempts; SENSITIVE_RATE_LIMIT_MAX covers change-password and
# the owner/developer "view password" support endpoints.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_MAX=20
# Optional: deploy behind a reverse proxy (e.g. TRUST_PROXY=1) so rate limiting
# sees real client IPs instead of the proxy's IP.
# TRUST_PROXY=1

# Response caching for read-heavy endpoints (recommended for high traffic).
# Set REDIS_URL (e.g. redis://127.0.0.1:6379 or rediss://... with TLS) to share
# the cache across multiple API instances. Without it a small in-process cache
# is used, which still protects a single-instance deployment. Cached responses
# live for CACHE_TTL_SECONDS and are purged the moment any record of that
# business changes. Set CACHE_ENABLED=false to disable caching entirely.
# REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60
# CACHE_ENABLED=false

# Used by `npm run seed:developer` to create the platform support administrator.
DEVELOPER_NAME=Platform Developer
DEVELOPER_EMAIL=developer@example.com
DEVELOPER_PASSWORD=replace-with-a-unique-password-min-6-chars-letters-and-numbers

# Used by `npm run seed:business-owner` to initialize the single business and its owner.
BUSINESS_NAME=WAGA BITS
BUSINESS_CITY=Kampala
OWNER_NAME=Business Owner
OWNER_EMAIL=owner@wagabits.com
OWNER_PASSWORD=replace-with-a-unique-password-min-6-chars-letters-and-numbers
