PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/stayserve
JWT_SECRET=replace-this-with-a-long-random-secret
# Required for the developer dashboard's "view password" support feature (min 32 chars).
PASSWORD_VAULT_KEY=replace-this-with-another-long-random-secret
CLIENT_URLS=http://localhost:5173,http://localhost:5174
COOKIE_SECURE=false

# Used by `npm run seed:developer` to create the platform support administrator.
DEVELOPER_NAME=Platform Developer
DEVELOPER_EMAIL=developer@example.com
DEVELOPER_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Used by `npm run seed:business-owner` to initialize the single business and its owner.
BUSINESS_NAME=WAGA BITS
BUSINESS_CITY=Kampala
OWNER_NAME=Business Owner
OWNER_EMAIL=owner@wagabits.com
OWNER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
