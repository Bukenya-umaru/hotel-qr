{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/proxy/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|socket[.]io/).*)",
      "destination": "/index.html"
    }
  ]
}
